APP_ENV=local
APP_TIMEZONE=America/Bogota

# Base de datos PROPIA de este microservicio (se crea sola con database/ms_auth.sql si no existe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elcuervo_auth
DB_USERNAME=root
DB_PASSWORD=

# Vigencia informativa del token de sesión (minutos)
APP_TOKEN_TTL_MINUTES=480

# Orígenes permitidos para consumir la API desde el navegador, separados por coma.
CORS_ALLOWED_ORIGIN=http://localhost,http://localhost:8080,http://127.0.0.1:8080
