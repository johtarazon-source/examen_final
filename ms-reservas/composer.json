{
    "name": "elcuervo/ms-reservas",
    "description": "Microservicio de reservas - Restaurante El Cuervo",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "4.*",
        "slim/psr7": "^1.8",
        "illuminate/database": "^9.52"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Config/database.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
