APP_ENV=local
APP_TIMEZONE=America/Bogota

# Base de datos PROPIA de este microservicio (se crea sola con database/ms_pedidos.sql si no existe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elcuervo_pedidos
DB_USERNAME=root
DB_PASSWORD=


# Orígenes permitidos para consumir la API desde el navegador, separados por coma.
CORS_ALLOWED_ORIGIN=http://localhost,http://localhost:8080,http://127.0.0.1:8080

# Bases de otros microservicios, SOLO LECTURA (nunca se escribe en ellas)
DB_AUTH_DATABASE=elcuervo_auth          # validar el token
DB_RESERVAS_DATABASE=elcuervo_reservas  # comprobar el estado de la mesa
DB_PRODUCTOS_DATABASE=elcuervo_productos # tomar nombre, precio y disponibilidad del producto
